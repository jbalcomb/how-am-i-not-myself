# Copy to .env (gitignored) and fill in.

# Bot token for the "How Am I Not Myself" Discord application.
DISCORD_TOKEN=

# The message-cache role created by ~/develai/scripts/start-message-dbs.sh
# (values are in ~/develai/.env).
MESSAGE_DB_USERNAME=discord_bot
MESSAGE_DB_PASSWORD=
MESSAGE_DB_KEYSPACE=discord_message_cache

# Optional overrides; defaults are loopback.
# CASSANDRA_HOST=127.0.0.1
# CASSANDRA_PORT=9042
# SCYLLADB_HOST=127.0.0.1
# SCYLLADB_PORT=9043
